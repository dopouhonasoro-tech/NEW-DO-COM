---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../data/site';

const marches = [
  { pays: 'Côte d’Ivoire', statut: 'Marché principal', texte: 'Base opérationnelle à Abidjan. La majorité de nos projets y sont menés.' },
  { pays: 'Sénégal', statut: 'Expansion prioritaire', texte: 'Marché d’expansion identifié, prospection engagée.' },
  { pays: 'Bénin · Togo', statut: 'Expansion prioritaire', texte: 'Marchés d’expansion visés dans la même logique régionale.' },
  { pays: 'Europe francophone', statut: 'Au cas par cas', texte: 'Projets acceptés lorsqu’ils sont pertinents et menables à distance.' },
];

const piliers = [
  ['Stratégie', 'Comprendre le modèle économique avant de proposer quoi que ce soit.'],
  ['Digital', 'Construire les systèmes qui portent l’activité au quotidien.'],
  ['Créativité', 'Rendre le message clair et distinctif, pas seulement joli.'],
  ['IA', 'Automatiser ce qui doit l’être, là où le gain est mesurable.'],
  ['Exécution', 'Livrer. La stratégie qui ne devient rien ne vaut rien.'],
];
---

<Layout
  title="À propos — agence de transformation digitale à Abidjan"
  description="DO COM, agence de transformation digitale fondée par Emmanuel Soro à Abidjan. Vision, marchés, façon de travailler."
  current="a-propos"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'AboutPage',
      name: 'À propos de DO COM',
      url: `${SITE.url}/a-propos/`,
    },
  ]}
>
  <PageHero
    eyebrow="À propos"
    lede="DO COM est née d’un constat simple : sur nos marchés, l’écart ne se joue plus entre les entreprises qui communiquent et celles qui ne communiquent pas, mais entre celles dont les opérations tiennent et celles qui s’épuisent à les tenir à la main."
  >
    Une agence qui commence<br />
    <span class="text-[color:var(--color-vert)]">par regarder comment vous travaillez.</span>
  </PageHero>

  <!-- Le nom -->
  <section class="sec-light py-16 md:py-28">
    <div class="container-app grid lg:grid-cols-12 gap-8 lg:gap-16">
      <div class="lg:col-span-5" data-reveal>
        <p class="eyebrow text-[color:var(--color-vert-texte)] mb-5">Le nom</p>
        <h2 class="h-xl">Dopouhona : être élevé pour voir plus loin.</h2>
      </div>
      <div class="lg:col-span-7 space-y-5 text-[color:var(--color-gris-clair)] lede leading-relaxed" data-reveal>
        <p>
          La signature de la marque — <em class="text-[color:var(--color-noir)] not-italic font-medium"
            >{SITE.signature}</em
          > — vient de là. Prendre de la hauteur avant d’agir, regarder plus loin que le problème
          immédiat, puis redescendre et construire.
        </p>
        <p>
          Ce n’est pas une formule décorative : c’est exactement l’ordre dans lequel nous travaillons.
          Comprendre la situation dans son ensemble avant de proposer un outil, et refuser de vendre
          la solution la plus visible quand elle n’est pas la plus utile.
        </p>
      </div>
    </div>
  </section>

  <!-- Fondateur -->
  <section class="sec-dark py-16 md:py-28 relative overflow-hidden">
    <div class="grid-field" aria-hidden="true"></div>
    <div class="container-app relative grid lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <div class="lg:col-span-4" data-reveal>
        <img
          src="/media/emmanuel.webp"
          alt="Emmanuel Soro, fondateur de DO COM"
          width="800"
          height="1000"
          loading="lazy"
          decoding="async"
          class="w-full max-w-sm rounded-xl border hl-dark object-cover"
        />
      </div>
      <div class="lg:col-span-8" data-reveal>
        <p class="eyebrow text-[color:var(--color-vert)] mb-5">Fondateur</p>
        <h2 class="h-xl mb-7">{SITE.fondateur}</h2>
        <div class="space-y-5 text-[color:var(--color-gris-sombre)] leading-relaxed lede max-w-2xl">
          <p>
            DO COM est dirigée depuis Abidjan par {SITE.fondateur}. L’agence intervient en direct
            sur ses projets et s’appuie sur des spécialistes selon les besoins, plutôt que
            d’entretenir une structure lourde qu’il faudrait justifier par du volume.
          </p>
          <p>
            Cette organisation a une conséquence que nous assumons : nous ne prenons pas tous les
            projets. Quand un besoin sort de notre périmètre ou qu’un calendrier n’est pas tenable,
            nous le disons au lieu de signer puis de décevoir.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Vision -->
  <section class="sec-paper py-16 md:py-28">
    <div class="container-app">
      <SectionHead eyebrow="Vision" tone="light">
        <h2 class="h-xl">
          Devenir un acteur de référence de la transformation digitale{' '}
          <span class="text-[color:var(--color-vert-texte)]">en Afrique francophone.</span>
        </h2>
        <p class="lede text-[color:var(--color-gris-clair)] max-w-2xl mt-6">
          À terme, faire évoluer une agence de services vers un écosystème de solutions digitales et
          intelligentes — des outils réutilisables d’un client à l’autre, plutôt que des projets
          repartant chaque fois de zéro. DO COM University OS en est la première brique.
        </p>
      </SectionHead>

      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4 mt-14 md:mt-20" data-reveal-stagger>
        {
          piliers.map(([titre, texte], i) => (
            <div class="step step-light">
              <p class="eyebrow text-[color:var(--color-vert-texte)] mb-3">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="h-md mb-2.5">{titre}</h3>
              <p class="text-sm text-[color:var(--color-gris-clair)] leading-relaxed">{texte}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Marchés -->
  <section class="sec-dark py-16 md:py-28 border-t hl-dark">
    <div class="container-app">
      <SectionHead eyebrow="Marchés">
        <h2 class="h-xl">Où nous intervenons.</h2>
      </SectionHead>

      <ul class="mt-14 md:mt-20 border-t hl-dark" data-reveal-stagger>
        {
          marches.map((m) => (
            <li class="grid md:grid-cols-12 gap-2 md:gap-8 py-6 md:py-7 border-b hl-dark items-baseline">
              <span class="md:col-span-4 font-display text-xl md:text-2xl font-semibold tracking-tight">
                {m.pays}
              </span>
              <span class="md:col-span-3 eyebrow text-[color:var(--color-vert)]">{m.statut}</span>
              <span class="md:col-span-5 text-sm text-[color:var(--color-gris-sombre)] leading-relaxed">
                {m.texte}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Clients types -->
  <section class="sec-light py-16 md:py-28">
    <div class="container-app">
      <SectionHead eyebrow="Avec qui nous travaillons" tone="light">
        <h2 class="h-xl">Des organisations qui ont quelque chose à faire tourner.</h2>
      </SectionHead>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-14" data-reveal-stagger>
        {
          [
            ['Entrepreneurs et TPE', 'Une activité qui fonctionne mais que son dirigeant tient seul, à bout de bras.'],
            ['PME', 'Une croissance qui rend visible tout ce que les processus manuels coûtaient déjà.'],
            ['Marques', 'Un besoin de visibilité qui doit se traduire en demande commerciale mesurable.'],
            ['Organisations de la société civile', 'Des moyens contraints et une exigence forte de traçabilité.'],
            ['Institutions et établissements', 'Des processus formalisés, nombreux, et encore largement manuels.'],
            ['Professionnels indépendants', 'Un temps facturable grignoté par des tâches administratives répétées.'],
          ].map(([titre, texte]) => (
            <div class="card-light carte-lueur p-7">
              <h3 class="h-md mb-2.5">{titre}</h3>
              <p class="text-sm text-[color:var(--color-gris-clair)] leading-relaxed">{texte}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>
