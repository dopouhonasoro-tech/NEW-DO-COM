---
/**
 * Symbole DO COM.
 * variant "light" = destiné à un fond sombre · "dark" = destiné à un fond clair.
 */
const { variant = 'light', size = 36 } = Astro.props;
const src = variant === 'light' ? '/media/symbol-light.webp' : '/media/symbol-dark.webp';
---

<img
  src={src}
  alt=""
  aria-hidden="true"
  width={size}
  height={size}
  loading="eager"
  decoding="async"
  class="block rounded-lg select-none shrink-0"
  style={`width:${size}px;height:${size}px;`}
/>
