---
const { variant = "light", size = 40 } = Astro.props;
// variant "light" = pour fond sombre (le symbole a un fond blanc, contraste avec la nav noire)
// variant "dark"  = pour fond clair (le symbole a un fond noir, contraste avec la nav claire)
const src = variant === "light" ? "/media/symbol-light.webp" : "/media/symbol-dark.webp";
---
<img
  src={src}
  alt="DO COM"
  width={size}
  height={size}
  loading="eager"
  decoding="async"
  class="block rounded-[20%] select-none"
  style={`width:${size}px;height:${size}px;`}
/>
