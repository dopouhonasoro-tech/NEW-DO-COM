---
/** En-tête de page intérieure. Le <h1> est passé en slot pour garder la mise en forme éditoriale. */
interface Props {
  eyebrow: string;
  lede?: string;
}
const { eyebrow, lede } = Astro.props as Props;
---

<section class="sec-dark relative overflow-hidden">
  <div class="grid-field" aria-hidden="true"></div>
  <div class="glow-vert w-[30rem] h-[30rem] -top-40 -right-32" aria-hidden="true"></div>

  <div class="container-app pt-28 md:pt-44 pb-14 md:pb-24 relative">
    <p class="eyebrow text-[color:var(--color-vert)] mb-6 animate-in">{eyebrow}</p>
    <h1 class="h-mega max-w-4xl animate-in" style="animation-delay:100ms">
      <slot />
    </h1>
    {
      lede && (
        <p
          class="lede text-[color:var(--color-gris-sombre)] max-w-2xl mt-8 animate-in"
          style="animation-delay:200ms"
        >
          {lede}
        </p>
      )
    }
    <slot name="apres" />
  </div>
</section>
