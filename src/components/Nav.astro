---
import Logo from './Logo.astro';
import { NAV, SITE } from '../data/site';

const { current = '' } = Astro.props;
---

<header
  data-nav
  class="fixed top-0 inset-x-0 z-50 border-b border-transparent transition-colors duration-300 data-[scrolled]:bg-[color:var(--color-noir)]/85 data-[scrolled]:backdrop-blur-md data-[scrolled]:border-[color:var(--color-filet-sombre)]"
>
  <div class="container-app flex items-center justify-between h-16 md:h-20">
    <a href="/" class="flex items-center gap-3" aria-label="DO COM — accueil">
      <Logo size={34} />
      <span class="flex flex-col leading-none">
        <span class="font-display text-[1.05rem] md:text-lg font-bold tracking-tight">DO COM</span>
        <span class="eyebrow text-[color:var(--color-gris-sombre)] mt-1 text-[9px] md:text-[10px]"
          >Voyez plus loin</span
        >
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-9" aria-label="Navigation principale">
      {
        NAV.map((link) => (
          <a
            href={link.href}
            aria-current={current === link.key ? 'page' : undefined}
            class:list={[
              'text-sm transition-colors relative py-1',
              current === link.key
                ? 'text-[color:var(--color-vert)]'
                : 'text-[color:var(--color-blanc)] hover:text-[color:var(--color-vert)]',
            ]}
          >
            {link.label}
            {current === link.key && (
              <span class="absolute -bottom-px left-0 right-0 h-px bg-[color:var(--color-vert)]" />
            )}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href="/contact/" class="btn btn-vert hidden sm:inline-flex !py-2.5 !px-4 text-sm">
        Parlons de votre projet
      </a>

      <button
        type="button"
        data-menu-btn
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="menu-mobile"
        class="lg:hidden w-11 h-11 -mr-2 flex flex-col items-center justify-center gap-[5px]"
      >
        <span class="block w-6 h-px bg-current transition-transform duration-300" data-bar-top></span>
        <span class="block w-6 h-px bg-current transition-transform duration-300" data-bar-bottom></span>
      </button>
    </div>
  </div>

  <div
    id="menu-mobile"
    data-menu
    hidden
    class="lg:hidden bg-[color:var(--color-noir)] border-t border-[color:var(--color-filet-sombre)]"
  >
    <div class="container-app py-5 flex flex-col">
      {
        NAV.map((link) => (
          <a
            href={link.href}
            class="font-display text-2xl font-semibold py-3.5 border-b border-[color:var(--color-filet-sombre)]"
          >
            {link.label}
          </a>
        ))
      }
      <a href="/contact/" class="btn btn-vert mt-6 w-full">
        Parlons de votre projet <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a
        href={SITE.whatsapp}
        rel="noopener"
        class="btn btn-ghost-light mt-3 w-full">WhatsApp direct</a
      >
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const top = document.querySelector<HTMLElement>('[data-bar-top]');
  const bottom = document.querySelector<HTMLElement>('[data-bar-bottom]');

  const setOpen = (open: boolean) => {
    if (!menu || !btn) return;
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    if (top) top.style.transform = open ? 'translateY(3px) rotate(45deg)' : '';
    if (bottom) bottom.style.transform = open ? 'translateY(-3px) rotate(-45deg)' : '';
  };

  btn?.addEventListener('click', () => setOpen(menu?.hidden ?? true));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) {
      setOpen(false);
      btn?.focus();
    }
  });
</script>
