---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  current?: string;
  /** Objets JSON-LD additionnels propres à la page. */
  jsonLd?: Record<string, unknown>[];
  /** Titre affiché dans l'onglet sans le suffixe « — DO COM ». */
  rawTitle?: boolean;
}

const {
  title,
  description,
  current = '',
  jsonLd = [],
  rawTitle = false,
} = Astro.props as Props;

const pageTitle = rawTitle ? title : `${title} — DO COM`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL('/media/og-docom.png', SITE.url).href;

/** Fiche d'organisation — présente sur toutes les pages. */
const organisation = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE.url}/#organisation`,
  name: SITE.name,
  slogan: SITE.signature,
  description:
    'DO COM accompagne les entreprises et les organisations dans leur transformation digitale : analyse des processus, sites web et plateformes, marketing digital, contenus, intelligence artificielle et automatisation.',
  url: SITE.url,
  email: SITE.email,
  telephone: SITE.telephoneE164,
  founder: { '@type': 'Person', name: SITE.fondateur },
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.ville,
    addressRegion: SITE.quartier,
    addressCountry: 'CI',
  },
  areaServed: [
    { '@type': 'Country', name: 'Côte d’Ivoire' },
    { '@type': 'Country', name: 'Sénégal' },
    { '@type': 'Country', name: 'Bénin' },
    { '@type': 'Country', name: 'Togo' },
  ],
  knowsLanguage: 'fr',
};

const schemas = [organisation, ...jsonLd];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>

    {/* Amorce : conditionne les animations à la présence de JavaScript.
        Sans JS, aucun contenu n'est masqué. Inline et en tête pour éviter tout clignotement. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#000000" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(schemas.length === 1 ? schemas[0] : schemas)}
    />
  </head>

  <body class="bg-[color:var(--color-noir)] text-[color:var(--color-blanc)]">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-[color:var(--color-vert)] focus:text-[color:var(--color-noir)] focus:px-4 focus:py-2 focus:rounded-md focus:font-medium"
      >Aller au contenu</a
    >

    <Nav current={current} />

    <main id="contenu">
      <slot />
    </main>

    <Footer />

    <div class="scroll-progress" aria-hidden="true"></div>

    <Motion />

    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // --- Révélation au scroll ---
      const targets = document.querySelectorAll('[data-reveal], [data-reveal-stagger]');
      if (reduced) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -6% 0px' }
        );
        targets.forEach((el) => io.observe(el));
      }

      // --- Barre de progression + état de la barre de navigation ---
      const progress = document.querySelector<HTMLElement>('.scroll-progress');
      const nav = document.querySelector<HTMLElement>('[data-nav]');
      let ticking = false;

      const update = () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        if (progress) {
          progress.style.width = max > 0 ? `${(window.scrollY / max) * 100}%` : '0%';
        }
        nav?.toggleAttribute('data-scrolled', window.scrollY > 12);
        ticking = false;
      };

      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true }
      );
      update();
    </script>
  </body>
</html>
